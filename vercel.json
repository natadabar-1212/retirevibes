{
  "redirects": [
    {
      "source": "/",
      "destination": "/homepage-mockup.html",
      "permanent": false
    },
    {
      "source": "/browse-homes-international.html",
      "destination": "/destinations/porto/real-estate/",
      "permanent": true
    },
    {
      "source": "/find-an-advisor.html",
      "destination": "/advisor-domestic.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}