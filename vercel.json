{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/homepage-mockup.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/browse-homes-international.html",
      "destination": "/destinations/porto/real-estate/",
      "permanent": true
    },
    {
      "source": "/find-an-advisor.html",
      "destination": "/advisor-domestic",
      "permanent": true
    },
    {
      "source": "/destinations.html",
      "destination": "/destinations/",
      "permanent": true
    },
    {
      "source": "/destination-coming-soon.html",
      "destination": "/destinations/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}